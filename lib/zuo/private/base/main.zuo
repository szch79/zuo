#lang zuo/private/base

(provide (all-from-out zuo/private/base))

(include "../base-common/main.zuo")

;; `match`/`struct-copy` and `values` are `#lang zuo`-only: they are wired in
;; here, not in the shared `base-common/main.zuo`, so they are deliberately
;; absent from `#lang zuo/hygienic` (which is a second-class language upstream —
;; we never compromise the `#lang zuo` design for it). See the plan's design
;; principle.
(require "values.zuo"
         "match.zuo")

(provide (all-from-out "values.zuo"
                       "match.zuo"))

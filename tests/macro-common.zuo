#lang zuo/datum

(define macro-dir (build-path tmp-dir "macros"))
(rm* macro-dir)
(mkdir macro-dir)

(check ((lambda lambda lambda) 3) '(3))
(check (let ([let 10]) let) 10)
(check (let ([let 11]) (let* ([let let]) let)) 11)
(check (let ([quote list]) '1) '(1))

(let ()
  (define-syntax (let-one stx)
    (list (quote-syntax let)
          (list (list (cadr stx) 1))
          (cadr (cdr stx))))
  (check (let-one x (list x x)) '(1 1))
  (check (let-one x (let ([let 0]) (list x let x))) '(1 0 1)))

(let ([five 5])
  (define-syntax (let-five stx)
    (list (quote-syntax let)
          (list (list (cadr stx) (quote-syntax five)))
          (cadr (cdr stx))))
  (check (let-five x (list x x)) '(5 5))
  (check (let-five x (let ([five 10]) (list x x))) '(5 5))
  (check (let ([five 10]) (let-five x (list x x))) '(5 5)))

(define (make-file* path content)
  (let ([fd (fd-open-output (build-path macro-dir path) :truncate)])
    (fd-write fd (~a "#lang " lang-name "\n"
                     (~s (cons 'begin content))))
    (fd-close fd)))

(define-syntax (make-file stx)
  (list (quote-syntax make-file*)
        (cadr stx)
        (cons (quote-syntax list)
              (map (lambda (c) (list (quote-syntax quote) c))
                   (cddr stx)))))

(make-file "exports-macro.zuo"
           (provide macro)
           (define (my-list . x) x)
           (define-syntax (macro stx)
             (list (quote-syntax my-list)
                   (cadr stx)
                   (cadr stx))))
  
(make-file "uses-macro.zuo"
           (require "exports-macro.zuo")
           (provide macro-to-macro)
           (define hello "hi")
           (macro hello)
           (define-syntax (macro-to-macro stx)
             (list (quote-syntax list)
                   (list (quote-syntax macro) (cadr stx))
                   (list (quote-syntax macro) (cadr stx)))))

(run-zuo* (list (build-path macro-dir "uses-macro.zuo"))
          ""
          (lambda (status out err)
            (check err "")
            (check status 0)
            (check out "(list \"hi\" \"hi\")\n")))

(make-file "uses-macro-to-macro.zuo"
           (require "uses-macro.zuo")
           (define-syntax (go stx) (quote-syntax 'went))
           (macro-to-macro go))

(run-zuo* (list (build-path macro-dir "uses-macro-to-macro.zuo"))
          ""
          (lambda (status out err)
            (check err "")
            (check status 0)
            (check out "(list \"hi\" \"hi\")\n(list (list 'went 'went) (list 'went 'went))\n")))

(make-file "exports-helper.zuo"
           (provide doubled)
           (define (my-list . x) x)
           (define (doubled stx)
             (list (quote-syntax my-list)
                   stx
                   stx)))
  
(make-file "uses-helper.zuo"
           (provide macro)
           (require "exports-helper.zuo")
           (define-syntax (macro stx)
             (doubled (cadr stx))))

(make-file "uses-macro-with-helper.zuo"
           (require "uses-helper.zuo")
           (define hello "hi")
           (macro hello))

(run-zuo* (list (build-path macro-dir "uses-macro-with-helper.zuo"))
          ""
          (lambda (status out err)
            (check err "")
            (check status 0)
            (check out "(list \"hi\" \"hi\")\n")))

;; struct compile-time info: a `struct` attaches a `define-for-syntax`
;; struct-info to the derived `NAME/info` id, retrievable through a
;; `binding-consumer`'s `local-value`; `struct-out` re-exports the surface.

(make-file "struct-info-same.zuo"
           (struct posn (x y))
           (define-syntax probe
             (binding-consumer
              (lambda (stx free-id=? local-value name)
                (let* ([info-id (datum->syntax (cadr stx)
                                               (string->symbol (~a (syntax-e (cadr stx)) "/info")))]
                       [sinfo (local-value info-id)]
                       [ctor (list-ref sinfo 2)]
                       [accs (list-ref sinfo 4)])
                  (list (quote-syntax list)
                        (list (list-ref sinfo 1) (list ctor 1 2))
                        (list (car accs) (list ctor 1 2))
                        (list (cadr accs) (list ctor 1 2)))))))
           (displayln (probe posn)))

(run-zuo* (list (build-path macro-dir "struct-info-same.zuo"))
          ""
          (lambda (status out err)
            (check err "")
            (check status 0)
            (check out "(#t 1 2)\n")))

;; struct in a local definition context: the accessor ids stored in
;; struct-info must resolve to the locally-bound accessors. (Regression:
;; in the non-hygienic expander this fails unless the struct-info
;; `define-for-syntax` is emitted after the accessor defines.)
(make-file "struct-info-local.zuo"
           (displayln
            (let ()
              (struct posn (x y))
              (define-syntax probe
                (binding-consumer
                 (lambda (stx free-id=? local-value name)
                   (let* ([info-id (datum->syntax (cadr stx)
                                                  (string->symbol (~a (syntax-e (cadr stx)) "/info")))]
                          [sinfo (local-value info-id)]
                          [ctor (list-ref sinfo 2)]
                          [accs (list-ref sinfo 4)])
                     (list (quote-syntax list)
                           (list (list-ref sinfo 1) (list ctor 1 2))
                           (list (car accs) (list ctor 1 2))
                           (list (cadr accs) (list ctor 1 2)))))))
              (probe posn))))

(run-zuo* (list (build-path macro-dir "struct-info-local.zuo"))
          ""
          (lambda (status out err)
            (check err "")
            (check status 0)
            (check out "(#t 1 2)\n")))

(make-file "exports-struct.zuo"
           (provide (struct-out posn))
           (struct posn (x y)))

(make-file "uses-struct.zuo"
           (require "exports-struct.zuo")
           (define-syntax probe
             (binding-consumer
              (lambda (stx free-id=? local-value name)
                (let* ([info-id (datum->syntax (cadr stx)
                                               (string->symbol (~a (syntax-e (cadr stx)) "/info")))]
                       [sinfo (local-value info-id)]
                       [ctor (list-ref sinfo 2)]
                       [accs (list-ref sinfo 4)])
                  (list (quote-syntax list)
                        (list (list-ref sinfo 1) (list ctor 5 6))
                        (list (car accs) (list ctor 5 6))
                        (list (cadr accs) (list ctor 5 6)))))))
           (displayln (list (posn? (posn 3 4)) (posn-x (posn 3 4)) (posn-y (posn 3 4))))
           (displayln (probe posn)))

(run-zuo* (list (build-path macro-dir "uses-struct.zuo"))
          ""
          (lambda (status out err)
            (check err "")
            (check status 0)
            (check out "(#t 3 4)\n(#t 5 6)\n")))

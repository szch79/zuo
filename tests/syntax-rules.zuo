#lang zuo

;; `syntax-rules` / `define-syntax-rule` — a `#lang zuo`-only feature (wired in
;; via base/main.zuo). Non-hygienic: templates emit bare symbols, so the macros
;; are used here at module top level where the base bindings they expand to
;; (`cons`, `list`, `if`, `match-pattern`, `splice-ellipsis`, …) are in scope.

(require "harness.zuo")

(alert "syntax-rules")

;; --- define-syntax-rule: simple / structural / multi-form body ---------------

(define-syntax-rule (my-id x) x)
(check (my-id 5) 5)

(define-syntax-rule (swap-pair a b) (cons b a))
(check (swap-pair 1 2) (cons 2 1))

(define-syntax-rule (seq a b) (begin a b))        ; two-form body via begin
(check (seq 1 2) 2)

;; --- syntax-rules: literals + non-literals, multiple rules -------------------

(define-syntax my-if
  (syntax-rules (then else)
    [(_ c then t else e) (if c t e)]))
(check (my-if #t then 'yes else 'no) 'yes)
(check (my-if #f then 'yes else 'no) 'no)

;; --- syntax-rules: fall-through + ellipsis (zero / one / many) + recursion ---

(define-syntax my-list
  (syntax-rules ()
    [(_) '()]
    [(_ x rest ...) (cons x (my-list rest ...))]))
(check (my-list) '())
(check (my-list 1) (list 1))
(check (my-list 1 2 3) (list 1 2 3))

;; --- syntax-rules: ellipsis with a fixed tail after it -----------------------

(define-syntax drop-last
  (syntax-rules ()
    [(_ x ... last) (list x ...)]))
(check (drop-last 1 2 3 4) (list 1 2 3))

;; --- syntax-rules: ellipsis under a sub-pattern → parallel pivoted lists -----

(define-syntax pairs->lists
  (syntax-rules ()
    [(_ (a b) ...) (list (list a ...) (list b ...))]))
(check (pairs->lists (1 2) (3 4) (5 6)) (list (list 1 3 5) (list 2 4 6)))

;; --- error: no rule matches (fires at expansion time) ------------------------

(check-fail (begin
              (define-syntax only-pair
                (syntax-rules ()
                  [(_ a b) (list a b)]))
              (only-pair 1))
            "no matching rule")

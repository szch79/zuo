#lang zuo

;; `values`/`call-with-values`/`let-values`/`let*-values`/`define-values` — a
;; `#lang zuo`-only feature (the `values` module is wired in via base/main.zuo).

(require "harness.zuo")

(alert "values")

(check (call-with-values (lambda () (values 1 2 3)) list) '(1 2 3))
(check (call-with-values (lambda () (values 42)) (lambda (x) x)) 42)
(check (call-with-values (lambda () 5) (lambda (x) x)) 5)   ; single value, no packet
(check (let-values ([(a b) (values 1 2)] [(c) (values 3)]) (list a b c)) '(1 2 3))
;; let-values is parallel: RHSes don't see each other's bindings
(check (let ([a 10] [b 20])
         (let-values ([(a b) (values b a)]) (list a b)))
       '(20 10))
(check (let*-values ([(a b) (values 1 2)] [(c) (values (+ a b))]) (list a b c)) '(1 2 3))
(check (let () (define-values (a b) (values 10 20)) (list a b)) '(10 20))
(check (let () (define-values (q) (values 7)) q) 7)
